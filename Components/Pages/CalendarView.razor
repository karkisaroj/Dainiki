@page "/calendar"
@using Dainiki.Components.Models
@using Dainiki.Components.Shared
@using MudBlazor
@inject AuthService Auth
@inject EntityService Entities
@inject IDialogService DialogService
@inject NavigationManager navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudPaper Class="pa-6" Style="max-height:80vh; overflow:auto;">
        <MudGrid Spacing="4">
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.h6" Class="mb-4">Calendar</MudText>

                <MudDatePicker Date="SelectedDate"
                               DateChanged="OnDateChanged"
                               PickerVariant="PickerVariant.Static"
                               DisableTextField
                               HighlightToday />
            </MudItem>

            <MudItem xs="12" md="8" Class="pl-md-6 mt-6 mt-md-0">
                <MudText Typo="Typo.h5" Class="mb-4">
                    Entries for @SelectedDate?.ToString("MMMM dd, yyyy")
                </MudText>

                @if (!PagedEntriesToday.Any())
                {
                    <MudText Align="Align.Center" Class="py-12">
                        No entries for this day
                    </MudText>
                }
                else
                {
                    @foreach (var entry in PagedEntriesToday)
                    {
                        <MudPaper Outlined Class="pa-4 mb-4" Style="cursor:pointer" @onclick="() => ShowEntryPopup(entry)">
                            <MudText Typo="Typo.subtitle1">@entry.Title</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="()=>EditEntry(entry)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(entry.Time.HasValue? DateTime.Today.Add(entry.Time.Value).ToString("hh:mm tt") : "Time not set")
                            </MudText>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mt-2">
                                @entry.PrimaryMood
                            </MudChip>
                        </MudPaper>
                    }

                    <MudPagination Count="@TotalPages"
                                   @bind-Selected="CurrentPage"
                                   MaxDisplayedPages="5"
                                   Class="mt-4" />
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private DateTime? SelectedDate = DateTime.Today;
    private List<EntriesModel> AllEntries = new();
    private int CurrentPage = 1;
    private int PageSize = 3;

    private int TotalPages => (int)Math.Ceiling((double)EntriesToday.Count / PageSize);

    private List<EntriesModel> EntriesToday =>
        AllEntries
            .Where(e => SelectedDate.HasValue && e.CreatedAt.Date == SelectedDate.Value.Date)
            .OrderBy(e => e.CreatedAt.TimeOfDay)
            .ToList();

    private List<EntriesModel> PagedEntriesToday =>
        EntriesToday
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUserId.HasValue)
        {
            AllEntries = await Entities.GetEntriesByUserAsync(Auth.CurrentUserId.Value);
        }
    }

  

    private void OnDateChanged(DateTime? newDate)
    {
        SelectedDate = newDate;
        CurrentPage = 1;
    }

    private void EditEntry(EntriesModel entry)
    {
        navigation.NavigateTo($"/addentry/{entry.Id}");
    }

    private async Task ShowEntryPopup(EntriesModel entry)
    {
        var parameters = new DialogParameters { ["Entry"] = entry };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<EntryDetailDialog>("Entry Details", parameters, options);
    }
}