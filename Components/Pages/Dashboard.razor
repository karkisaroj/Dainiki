@page "/dashboard"
@using Dainiki.Components.Services
@inject AuthService Auth
@inject NavigationManager NavManager
@inject EntityService Entities
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" Class="mb-6" Color="Color.Primary">
        Welcome back, @Auth.CurrentUser!
    </MudText>

    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-5 d-flex flex-column justify-center" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Primary" Align="Align.Center">Total Entries</MudText>
                <MudText Typo="Typo.h3" Color="Color.Primary" Align="Align.Center" Class="mt-3">0</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-5 d-flex flex-column justify-center" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Secondary" Align="Align.Center">This Week</MudText>
                <MudText Typo="Typo.h3" Color="Color.Secondary" Align="Align.Center" Class="mt-3">0</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-5 d-flex flex-column justify-center" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Tertiary" Align="Align.Center">This Month</MudText>
                <MudText Typo="Typo.h3" Color="Color.Tertiary" Align="Align.Center" Class="mt-3">0</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-5 d-flex flex-column justify-center" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Success" Align="Align.Center">Current Streak</MudText>
                <MudText Typo="Typo.h3" Color="Color.Success" Align="Align.Center" Class="mt-3">0 days</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-8" Spacing="4">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="2" Class="pa-6 rounded-lg">
                <div class="d-flex justify-space-between align-center mb-6">
                    <MudText Typo="Typo.h5" Color="Color.Primary">Recent Entries</MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Href="/addentry"
                               Size="Size.Medium">
                        New Entry
                    </MudButton>
                </div>

                <MudPaper Elevation="0"
                          Class="pa-0"
                          Style="max-height: 520px; overflow-y: auto;">
                    @if (!RecentEntries.Any())
                    {
                        <div class="text-center py-12">
                            <MudText Typo="Typo.body1" Color="Color.Secondary">
                                No entries yet. Start writing your first journal entry!
                            </MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var entry in RecentEntries)
                        {
                            <MudPaper Outlined="true"
                                      Elevation="0"
                                      Class="pa-4 mb-3 rounded-lg">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <div>
                                        <MudText Typo="Typo.subtitle1"
                                                 Color="Color.Primary"
                                                 Class="font-weight-medium">
                                            @entry.Title
                                        </MudText>
                                        <MudText Typo="Typo.caption"
                                                 Color="Color.Secondary"
                                                 Class="mt-1">
                                            @entry.Date.ToString("MMM dd, yyyy") - @(entry.Time.HasValue?DateTime.Today.Add(entry.Time.Value).ToString("hh:mm tt"):"Time not set" )
                                        </MudText>
                                    </div>

                                    <div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Secondary"
                                                       OnClick="()=>EditEntry(entry)"
                                                       AriaLabel="Edit entry" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="()=>DeleteEntry(entry)"
                                                       AriaLabel="Delete entry" />
                                    </div>
                                </div>

                                <MudStack Row="true" Spacing="1" Class="mb-3">
                                    @if (!string.IsNullOrWhiteSpace(entry.PrimaryMood))
                                    {
                                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                            @entry.PrimaryMood
                                        </MudChip>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(entry.SecondaryMoods))
                                    {
                                        foreach (var mood in entry.SecondaryMoods.Split(','))
                                        {
                                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">
                                                @mood.Trim()
                                            </MudChip>
                                        }
                                    }

                                </MudStack>

                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="line-clamp-3">
                                    @((MarkupString)entry.Content)
                                </MudText>


                                <MudStack Row="true" Spacing="1" Class="mt-3">
                                    @if (!String.IsNullOrWhiteSpace(entry.Tags))
                                    {
                                    @foreach (var tag in entry.Tags.Split(","))
                                    {
                                        <MudChip T="string"
                                                 Color="Color.Default"
                                                 Variant="Variant.Text"
                                                 Size="Size.Small">
                                            #@tag.Trim()
                                        </MudChip>
                                    }
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    }
                </MudPaper>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">Quick Actions</MudText>
                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Href="/journalentry"
                               StartIcon="@Icons.Material.Filled.Edit">
                        New Entry
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Href="/search"
                               StartIcon="@Icons.Material.Filled.Search">
                        View All Entries
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Tertiary"
                               FullWidth="true"
                               Href="/settings"
                               StartIcon="@Icons.Material.Filled.Settings">
                        Settings
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="2" Class="pa-6 mt-4">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">Tip of the Day</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Writing regularly helps improve mental clarity and emotional well-being.
                    Try to journal at the same time each day to build a lasting habit.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<EntriesModel> RecentEntries { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            NavManager.NavigateTo("/login");
            return;
        }
        if (Auth.CurrentUserId.HasValue)
        {
            RecentEntries = await Entities.GetEntriesByUserAsync(Auth.CurrentUserId.Value);
        }
    }
    private void EditEntry(EntriesModel entry)
    {
        NavManager.NavigateTo($"/addentry/{entry.Id}");
    }

    private void DeleteEntry(EntriesModel entry)
    {
        bool removed=RecentEntries.Remove(entry);
        if (removed)
        {
            Entities.DeleteEntryAsync(entry.Id);
            StateHasChanged();
            Snackbar.Add("Deleted Successfully", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to delete", Severity.Error);
        }
    }

}