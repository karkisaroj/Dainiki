@page "/dashboard"
@using Dainiki.Components.Services
@inject AuthService Auth

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" Class="mb-6">Welcome back, @Auth.CurrentUser!</MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Primary">Total Entries</MudText>
                <MudText Typo="Typo.h3" Class="mt-4">0</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Secondary">This Week</MudText>
                <MudText Typo="Typo.h3" Class="mt-4">0</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Tertiary">This Month</MudText>
                <MudText Typo="Typo.h3" Class="mt-4">0</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 150px;">
                <MudText Typo="Typo.h6" Color="Color.Success">Current Streak</MudText>
                <MudText Typo="Typo.h3" Class="mt-4">0 days</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-8">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">Recent Entries</MudText>
                <MudText Color="Color.Secondary" Class="text-center py-8">
                    No entries yet. Start writing your first journal entry!
                </MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/journalentry"
                               StartIcon="@Icons.Material.Filled.Add">
                        Create New Entry
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">Quick Actions</MudText>
                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Href="/journalentry"
                               StartIcon="@Icons.Material.Filled.Edit">
                        New Entry
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Href="/journalentry"
                               StartIcon="@Icons.Material.Filled.Search">
                        View All Entries
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Tertiary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Settings">
                        Settings
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="2" Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-2">Tip of the Day</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Writing regularly helps improve mental clarity and emotional well-being.
                    Try to journal at the same time each day to build a lasting habit.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
        {
      
            NavManager.NavigateTo("/login");
        }
    }

    [Inject] private NavigationManager NavManager { get; set; }
}