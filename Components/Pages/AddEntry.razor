@page "/addentry"
@using MudBlazor
@inject IJSRuntime JS
@inject AuthService Auth

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudText Typo="Typo.h5" GutterBottom="true">
        New Entry - @DateTime.UtcNow.ToString("MMMM dd, yyyy")
    </MudText>

    <MudTextField @bind-Value="Title"
                  Label="Title"
                  Variant="Variant.Outlined"
                  FullWidth />

    <MudText Typo="Typo.subtitle1" Class="mt-4" GutterBottom="true">
        Content
    </MudText>

    <MudPaper Variant="Variant.Outlined">
        <div id="quill-editor" style="height:300px;"></div>
    </MudPaper>

    <MudPaper>
        @((MarkupString)entry.Content)
    </MudPaper>

    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" GutterBottom="true">
        How did you feel?
    </MudText>

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6">
            <MudSelect T="string"
                       Label="Primary Mood (Required)"
                       @bind-Value="PrimaryMood"
                       Variant="Variant.Outlined"
                       FullWidth>
                @foreach (var mood in PrimaryMoods)
                {
                    <MudSelectItem Value="@mood">@mood</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSelect T="string"
                       Label="Secondary Moods (Optional)"
                       MultiSelection="true"
                       SelectedValues="SecondaryMoods"
                       SelectedValuesChanged="@(v => SecondaryMoods = v.ToList())"
                       Variant="Variant.Outlined"
                       FullWidth>
                @foreach (var mood in SecondaryMoodOptions)
                {
                    <MudSelectItem Value="@mood">@mood</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudSelect T="string"
                       Label="Phase of Life"
                       @bind-Value="PhaseOfLife"
                       Variant="Variant.Outlined"
                       FullWidth>
                @foreach (var phase in LifePhases)
                {
                    <MudSelectItem Value="@phase">@phase</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.subtitle1" Class="mt-6" GutterBottom="true">
        Tags
    </MudText>

    <MudTextField @bind-Value="Tags"
                  Placeholder="Add Custom / Seed it Pre-build"
                  Variant="Variant.Outlined"
                  FullWidth />

    <MudStack Row="true" Spacing="3" Justify="Justify.FlexStart" Class="mt-8">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   Size="Size.Large"
                   OnClick="SaveEntry"
                   Style="min-width: 140px;">
            SAVE ENTRY
        </MudButton>
    </MudStack>
</MudContainer>

@code {
    private string Title = "";
    private string PrimaryMood = "";
    private List<string> SecondaryMoods = new();
    private string PhaseOfLife = "";
    private string Tags = "";

    private List<string> PrimaryMoods = [];
    private List<string> SecondaryMoodOptions = [];
    private List<string> LifePhases = [];

    private EntriesModel entry = new();

    private IJSObjectReference? _quillModule;
    private bool _quillReady;

    protected override void OnInitialized()
    {
        PrimaryMoods = ["Happy", "Sad", "Calm", "Angry", "Excited"];
        SecondaryMoodOptions = ["Work", "Health", "Travel", "Relationships", "Study"];
        LifePhases = ["School life", "College life", "Work life", "Family life"];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeQuill");
        }
    }

    private async Task SaveEntry()
    {
        var content = await JS.InvokeAsync<string>("getQuillContent");
        Console.WriteLine($"Saving content: {content}");
        entry.Content = content;
    }

    public async ValueTask DisposeAsync()
    {
          try
        {
            if (_quillModule is not null)
            {
                await _quillModule.InvokeVoidAsync("disposeQuill");
                await _quillModule.DisposeAsync();
            }
        }
        catch (JSException jsEx)
        {
            Console.WriteLine($"Dispose JSException: {jsEx.Message}");
        }
    }
}