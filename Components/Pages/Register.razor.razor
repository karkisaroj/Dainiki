/* Card */
.auth-surface {
    max-width: 420px;
    padding: 3rem 3.5rem;
    margin-top: 6rem;
    border-radius: 22px;
    background: #ffffff;
    box-shadow:
        0 18px 36px rgba(0, 0, 0, 0.08),
        0 6px 12px rgba(0, 0, 0, 0.05);
}

/* Header */
.auth-header {
    text-align: center;
    margin-bottom: 2.5rem;
}

.auth-title {
    font-weight: 600;
    letter-spacing: -0.03em;
}

.auth-subtitle {
    margin-top: 0.4rem;
    color: rgba(0, 0, 0, 0.6);
}

.auth-accent {
    width: 48px;
    height: 4px;
    margin: 1.2rem auto 0;
    border-radius: 4px;
    background: linear-gradient(90deg, #6750a4, #03dac6);
}

/* Remove MudForm artifacts */
.auth-form {
    border: none !important;
}

.auth-form::after,
.auth-form::before {
    display: none !important;
}

/* Center button */
.button-row {
    display: flex;
    justify-content: center;
}

/* Button */
.auth-button {
    min-width: 160px;
    height: 44px;
    padding: 0 1.6rem;

    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: none;

    background: linear-gradient(135deg, #6750a4, #7f67be);
    color: white;

    box-shadow:
        0 8px 18px rgba(103, 80, 164, 0.35),
        0 3px 6px rgba(0, 0, 0, 0.08);

    transition: all 0.18s ease;
}

.auth-button:hover:not(:disabled) {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #7f67be, #8e7dd1);
}

.auth-button:active:not(:disabled) {
    transform: translateY(0);
}

.auth-button:disabled {
    background: linear-gradient(135deg, #c7bddf, #b6acd4);
    box-shadow: none;
}
