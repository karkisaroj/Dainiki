@inject AuthService Auth

<MudNavMenu Class="d-flex flex-column justify-space-between pa-2" Style="height: 100%;">
    <div>
        <MudText Typo="Typo.h6" Class="mb-4 text-center">Dainiki</MudText>
        <MudDivider Class="mb-4" />

        @if (Auth.IsLoggedIn)
        {
            <MudNavMenu Class="d-flex flex-column h-100">
                <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" Class="mb-2">Dashboard</MudNavLink>
                <MudNavGroup Title="Entries" Icon="@Icons.Material.Filled.Book" Expanded="true">
                    <MudNavLink Href="/entries" Icon="@Icons.Material.Filled.List" Class="mb-1 pl-6">All Entries</MudNavLink>
                    <MudNavLink Href="/addentry" Icon="@Icons.Material.Filled.Add" Class="mb-1 pl-6">New Entry</MudNavLink>
                </MudNavGroup>

                <MudNavLink Href="/calendar" Icon="@Icons.Material.Filled.CalendarMonth" Class="mb-2">Calendar View</MudNavLink>
                <MudNavLink Href="/search" Icon="@Icons.Material.Filled.Search" Class="mb-2">Search & Filters</MudNavLink>
                <MudNavLink Href="/analytics" Icon="@Icons.Material.Filled.Analytics" Class="mb-2">Analytics</MudNavLink>
                <MudNavLink Href="/export" Icon="@Icons.Material.Filled.Download" Class="mb-2">Export Journal</MudNavLink>
                <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings" Class="mb-2">Settings</MudNavLink>

                <MudSpacer />
                <MudDivider Class="my-2" />
                <MudNavLink Href="/logout" Icon="@Icons.Material.Filled.Logout" Class="mb-2">Logout</MudNavLink>
            </MudNavMenu>
        }
    </div>

    @if (!Auth.IsLoggedIn)
    {
        <div>
            <MudDivider Class="mb-2" />
            <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd" Class="mb-2">Register</MudNavLink>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login" Class="mb-2">Login</MudNavLink>
        </div>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}