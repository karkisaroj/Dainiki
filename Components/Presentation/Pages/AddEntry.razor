@page "/addentry/{id:int?}"
@using Dainiki.Components.Application.Services
@using Dainiki.Components.Domain.Models
@using Dainiki.Components.Shared.Constants
@using MudBlazor
@inject IJSRuntime JS
@inject AuthService Auth
@inject QuillEditorService Quill
@implements IAsyncDisposable
@inject EntityService Entities
@inject NavigationManager Navigate
@inject ISnackbar snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudText Typo="Typo.h5" GutterBottom>
        New Entry - @DateTime.UtcNow.ToString("MMMM dd, yyyy")
    </MudText>

    <MudTextField @bind-Value="Title"
                  Label="Title"
                  Variant="Variant.Outlined"
                  FullWidth />

    <MudText Typo="Typo.subtitle1" Class="mt-4" GutterBottom>
        Content
    </MudText>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               Class="mb-3"
               OnClick="TogglePreview">
        @(ShowPreview ? "Hide Preview" : "Show Preview")
    </MudButton>

    <MudPaper Variant="Variant.Outlined">
        <div id="quill-editor" style="height:300px;"></div>
    </MudPaper>

    @if (ShowPreview)
    {
        <MudPaper Class="mt-4 pa-4">
            <MudText Typo="Typo.subtitle1" GutterBottom>Preview</MudText>
            <MudDivider Class="mb-3" />
            <div>@((MarkupString)PreviewContent)</div>
        </MudPaper>
    }

    <MudDivider Class="my-6" />

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6">
            <MudSelect T="string"
                       Label="Primary Mood"
                       @bind-Value="PrimaryMood"
                       Variant="Variant.Outlined"
                       FullWidth>
                @foreach (var mood in PrimaryMoods)
                {
                    <MudSelectItem Value="@mood">@mood</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSelect T="string"
                       Label="Secondary Moods"
                       MultiSelection
                       SelectedValues="SecondaryMoods"
                       SelectedValuesChanged="OnSecondaryMoodsChanged"
                       Variant="Variant.Outlined"
                       FullWidth>
                @foreach (var mood in SecondaryMoodOptions)
                {
                    <MudSelectItem Value="@mood">@mood</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudSelect T="string"
                       Label="Phase of Life"
                       @bind-Value="PhaseOfLife"
                       Variant="Variant.Outlined"
                       FullWidth>
                @foreach (var phase in LifePhases)
                {
                    <MudSelectItem Value="@phase">@phase</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudTextField @bind-Value="Tags"
                  Label="Tags"
                  Variant="Variant.Outlined"
                  FullWidth
                  Class="mt-6" />

    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudSelect T="string"
                       Label="Select Pre-Defined Tags (Optional)"
                       MultiSelection
                       SelectedValues="PreDefinedTags"
                       SelectedValuesChanged="v => PreDefinedTags = v.ToList()"
                       Variant="Variant.Outlined"
                       FullWidth>
                @if (PreDefinedTagsOptions != null)
                {
                    @foreach (var mood in PreDefinedTagsOptions)
                    {
                        <MudSelectItem Value="@mood">@mood</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               Size="Size.Large"
               Class="mt-6"
               OnClick="SaveEntry">
        Save Entry
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               Size="Size.Large"
               Class="mt-6"
               OnClick="CancelEntry">
        Cancel Entry
    </MudButton>
</MudContainer>

@code {
    private bool ShowPreview;
    private string Content="";
    [Parameter] public int? Id { get; set; }
    private string PreviewContent = "";
    private string Title = "";
    private string PrimaryMood = "";
    private List<string> SecondaryMoods = new();
    private string PhaseOfLife = "";
    private string Tags = "";
    private List<string>? PreDefinedTags = new();

    private List<string> PrimaryMoods = EntryOptions.PrimaryMoods;
    private List<string> SecondaryMoodOptions = EntryOptions.SecondaryMoodOptions;
    private List<string> LifePhases = EntryOptions.LifePhases;
    private List<string> PreDefinedTagsOptions = EntryOptions.PreDefinedTagsOptions;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existingEntry = await Entities.GetEntryByIdAsync(Id.Value);
            if (existingEntry != null)
            {
                Title = existingEntry.Title;
                PrimaryMood = existingEntry.PrimaryMood;
                SecondaryMoods = existingEntry.SecondaryMoods?
                    .Split(',', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new();
                PhaseOfLife = existingEntry.PhaseOfLife;
                Tags = existingEntry.Tags;
                Content = existingEntry.Content;

                PreDefinedTags = !string.IsNullOrWhiteSpace(existingEntry.PreDefinedTags)
                    ? existingEntry.PreDefinedTags.Split(",", StringSplitOptions.RemoveEmptyEntries).ToList()
                    : new List<string>();
            }
        }
    }

    private void OnSecondaryMoodsChanged(IEnumerable<string> values)
    {
        var selected = values.ToList();
        if (selected.Count > 2)
        {
            SecondaryMoods = selected.Take(2).ToList();
            snackbar.Add("You can select up to 2 secondary moods only.", Severity.Warning);
        }
        else
        {
            SecondaryMoods = selected;
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeQuill");

            if (!string.IsNullOrEmpty(Content))
            {
                await JS.InvokeVoidAsync("setQuillContent", Content);
                StateHasChanged();
            }
        }
    }

    private async Task TogglePreview()
    {
        if (!ShowPreview)
            PreviewContent = await JS.InvokeAsync<string>("getQuillContent");

        ShowPreview = !ShowPreview;
    }

    private string CombineTags(string customTags, List<string>? predefinedTags)
    {
        var tagsList = new List<string>();
        if (!string.IsNullOrWhiteSpace(customTags))
            tagsList.AddRange(customTags.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(t => t.Trim()));
        if (predefinedTags != null && predefinedTags.Any())
            tagsList.AddRange(predefinedTags.Select(t => t.Trim()));
        return string.Join(",", tagsList.Distinct());
    }

    private async Task SaveEntry()
    {
        try
        {
            Content = await Quill.GetContentAsync();
            var todayEntry = await Entities.GetEntryByDateAsync(Auth.CurrentUserId ?? 0, DateTime.UtcNow.Date);
            var existingEntry = Id.HasValue? await Entities.GetEntryByIdAsync(Id.Value): null;
            bool hasCustomTags = !string.IsNullOrWhiteSpace(Tags);
            bool hasPredefinedTags = PreDefinedTags != null && PreDefinedTags.Any();
            if(!hasCustomTags && !hasPredefinedTags)
            {
                snackbar.Add("Please provide either custom tags or choose predefined tags", Severity.Error);
                return;
            }
            Console.WriteLine($"Checking for entry on {DateTime.UtcNow.Date} for user {Auth.CurrentUserId}"); 
            if (!Id.HasValue && todayEntry != null)
            {
                snackbar.Add("You can only create one entry per day.", Severity.Error);
                return;
            }
            var entry = new EntriesModel
            {
                Id=existingEntry?.Id??0,
                UserId = Auth.CurrentUserId ?? 0,
                Title = Title,
                Content = Content,
                PrimaryMood = PrimaryMood,
                SecondaryMoods = string.Join(",", SecondaryMoods),
                PhaseOfLife = PhaseOfLife,
                Tags = CombineTags(Tags, PreDefinedTags),
                PreDefinedTags=hasPredefinedTags?string.Join(",",PreDefinedTags!):null,
                Date = existingEntry?.Date ?? DateTime.UtcNow.Date,
                CreatedAt = existingEntry?.CreatedAt ?? DateTime.Now,
                UpdatedAt = DateTime.Now
            };
            if (Id.HasValue)
                await Entities.UpdateEntryAsync(entry);
            else
                await Entities.SaveEntryAsync(entry, Auth.CurrentUserId ?? 0);
            StateHasChanged();
            snackbar.Add("Saved entry successfully", Severity.Success);
            Navigate.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            snackbar.Add($"Error saving entry: {ex.Message}", Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("destroyQuill"); 
    }

    public void CancelEntry()
    {
        Navigate.NavigateTo("/entries");
         snackbar.Add("Cancelled entry", Severity.Info);
    }
}
