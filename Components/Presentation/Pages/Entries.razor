@page "/entries"
@using Dainiki.Components.Application.Services
@using Dainiki.Components.Models
@using MudBlazor
@inject NavigationManager Navigation
@inject AuthService Auth
@inject EntityService Entity


<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4" Color="Color.Primary">All Journal Entries</MudText>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/addentry"
                   Size="Size.Large">
            New Entry
        </MudButton>
    </div>

    <MudPaper Elevation="2"
              Class="pa-6 rounded-lg"
              Style="max-height: 75vh; overflow-y: auto; border-radius: 12px;">

        @if (!AllEntries.Any())
        {
            <div class="text-center py-12">
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    No entries yet. Start writing your first journal entry!
                </MudText>
            </div>
        }
        else
        {
            <MudTimeline TimelinePosition="TimelinePosition.Alternate"
                         TimelineAlign="TimelineAlign.Start">
                @foreach (var entry in AllEntries.OrderByDescending(e => e.Date).ThenByDescending(e => e.Time))
                {
                    <MudTimelineItem Color="Color.Default">
                        <ItemDot>
                            <MudIcon Icon="@Icons.Material.Filled.Circle"
                                     Color="Color.Primary"
                                     Size="Size.Small" />
                        </ItemDot>

                        <ItemOpposite>
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                @entry.Date.ToString("MMM dd, yyyy")
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime"
                                         Size="Size.Small"
                                         Class="ml-1 mr-1" />
                                @(entry.Time.HasValue?DateTime.Today.Add(entry.Time.Value).ToString("hh:mm tt"):"Time not set")
                            </MudText>
                        </ItemOpposite>

                        <ChildContent>
                            <MudPaper Elevation="1"
                                      Class="pa-4 mb-3 rounded-lg"
                                      Outlined="true">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <MudText Typo="Typo.subtitle1"
                                             Color="Color.Default"
                                             Class="font-weight-medium">
                                        @entry.Title
                                    </MudText>
                                    <div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="() => EditEntry(entry)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="() => DeleteEntry(entry)" />
                                    </div>
                                </div>

                                <MudChip T="string"
                                         Color="Color.Success"
                                         Variant="Variant.Filled"
                                         Size="Size.Small"
                                         Class="mb-3">
                                    @entry.PrimaryMood
                                </MudChip>
                            </MudPaper>
                        </ChildContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
    </MudPaper>

</MudContainer>

@code {
    private List<EntriesModel> AllEntries { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
        if (Auth.CurrentUserId.HasValue)
        {
            AllEntries = await Entity.GetEntriesByUserAsync(Auth.CurrentUserId.Value);
        }
    }

    private void EditEntry(EntriesModel entry)
    {
        Navigation.NavigateTo($"/addentry/{entry.Id}");
    }

    private void DeleteEntry(EntriesModel entry)
    {
        AllEntries.Remove(entry);
        StateHasChanged();
    }

   
}