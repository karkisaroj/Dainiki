@page "/register"
@using Dainiki.Components.Application.Services
@using Dainiki.Components.Models
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudPaper Class="pa-8 mx-auto" Style="max-width: 600px; box-shadow: none; border: 1px solid #e0e0e0; margin-top: 24px;">
    <MudText Typo="Typo.h4" Class="mb-8" Style="font-weight: 400; text-align: center; padding-top: 8px;">
        Register
    </MudText>

    <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
        <MudTextField T="string"
                      Label="First name"
                      @bind-Value="registerModel.FirstName"
                      Required="true"
                      RequiredError="First name is required"
                      MaxLength="8"
                      Counter="8"
                      Variant="Variant.Outlined"
                      Class="mb-2" />
        <MudText Typo="Typo.caption" Class="mb-4" Style="color: #666;">
            Max 8 characters
        </MudText>

        <MudTextField T="string"
                      Label="Username"
                      @bind-Value="registerModel.Username"
                      Required="true"
                      RequiredError="Username is required"
                      Variant="Variant.Outlined"
                      Class="mb-6" />

        <MudTextField T="string"
                      Label="Password"
                      Value="registerModel.Password"
                      InputType="InputType.Password"
                      Required="true"
                      ValueChanged="@((string newPw)=>OnPasswordChanged(newPw))"
                      RequiredError="Password is required"
                      Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"
                      Variant="Variant.Outlined"
                      Class="mb-2" />
        <MudText Typo="Typo.caption" Class="mb-4" Style="color: #666;">
            Choose a strong password
        </MudText>

        <MudTextField T="string"
                      Label="Confirm Password"
                      @bind-Value="registerModel.ConfirmPassword"
                      InputType="InputType.Password"
                      Immediate="true"
                      Required="true"
                      RequiredError="Please confirm your password"
                      Validation="@(new Func<string, string?>(PasswordMatch))"
                      Variant="Variant.Outlined"
                      Class="mb-2" />
        <MudText Typo="Typo.caption" Class="mb-6" Style="color: #666;">
            Repeat the password
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Dark"
                   OnClick="HandleRegister"
                   FullWidth="true"
                   Style="text-transform: uppercase; font-weight: 500; padding: 12px 24px;">
            REGISTER
        </MudButton>

        <div class="mt-4 text-center">
            <MudText Typo="Typo.body2" Style="color: #666;">
                Already have an account?
                <MudLink Href="/login" Style="color: #6366f1; text-decoration: none; font-weight: 500;">
                    Login
                </MudLink>
            </MudText>
        </div>
    </MudForm>

    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 500; color: #333;">
        Validation Summary
    </MudText>

    @if (errors?.Length > 0)
    {
        <div Style="background-color: #ffebee; border-radius: 4px; padding: 12px; margin-bottom: 8px;">
            @foreach (var error in errors)
            {
                <MudText Typo="Typo.body2" Style="color: #c62828; margin-bottom: 4px;">
                    • @error
                </MudText>
            }
        </div>
    }
    else if (success)
    {
        <MudText Typo="Typo.body2" Style="color: #2e7d32; text-align: center; font-style: italic;">
            ✓ Form is valid. Ready to submit.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Style="color: #666; text-align: center; font-style: italic;">
            Fill out the form correctly to see the success message.
        </MudText>
    }
</MudPaper>

@code {
    private MudForm ?form;
    private bool success;
    private string[] errors = { };
    // private bool agree;

    private RegisterModel registerModel = new();

    private async Task OnPasswordChanged(String newPassword)
    {
        registerModel.Password = newPassword;
        if (form != null)
        {
            await form.Validate();
        }
    }

    private async Task HandleRegister()
    {
        await form!.Validate();

        if (form.IsValid || success)
        {
            var registered = Auth.Register(registerModel);
            if (await registered)
            {
                Snackbar.Add(" Registration successful! Please login.", Severity.Success);

                Nav.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add(" Username already exists", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add(" Please fix validation errors", Severity.Error);
        }
    }

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "Password is required!";
            yield break;
        }
        if (pw.Length < 8)
            yield return "Password must be at least 8 characters";
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[A-Z]"))
            yield return "Password must contain at least one capital letter";
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[a-z]"))
            yield return "Password must contain at least one lowercase letter";
        if (!System.Text.RegularExpressions.Regex.IsMatch(pw, @"[0-9]"))
            yield return "Password must contain at least one digit";
    }

    private string? PasswordMatch(string arg)
    {
        if (registerModel.Password != arg)
            return "Passwords don't match";
        return null;
    }
}