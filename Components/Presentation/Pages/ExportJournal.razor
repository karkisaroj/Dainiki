@page "/export"
@using MudBlazor
@using Dainiki.Components.Domain.Models
@inject PdfExportService PdfService
@inject EntityService Entities
@inject AuthService Auth
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <!-- Page Title -->
    <MudText Typo="Typo.h4" Class="mb-6 font-weight-bold text-primary">
        Export Journal
    </MudText>

    <MudGrid Gutter="GutterSize.Small">
        <!-- Filters Section -->
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-6" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Filters</MudText>
                <MudDivider Class="mb-4" />

                <!-- Date Range -->
                <MudText Typo="Typo.subtitle1" Class="mb-2">Select Date Range</MudText>
                <MudDateRangePicker DateRange="DateRange"
                                    DateRangeChanged="OnDateRangeChanged"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    FullWidth
                                    Class="mb-4" />

                <!-- Mood Filter -->
                <MudText Typo="Typo.subtitle1" Class="mb-2">Filter by Mood (Optional)</MudText>
                <MudSelect T="string"
                           Label="Select Moods"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectedValues="SelectedMoods"
                           SelectedValuesChanged="OnSelectedMoodsChanged"
                           Margin="Margin.Dense"
                           FullWidth
                           Class="mb-4">
                    @foreach (var mood in MoodOptions)
                    {
                        <MudSelectItem Value="@mood">@mood</MudSelectItem>
                    }
                </MudSelect>

                <MudDivider Class="my-4" />

                <!-- Tag Filter -->
                <MudText Typo="Typo.subtitle1" Class="mb-2">Filter by Tags (Optional)</MudText>
                <MudSelect T="string"
                           Label="Select Tags"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectedValues="SelectedTags"
                           SelectedValuesChanged="OnSelectedTagsChanged"
                           Margin="Margin.Dense"
                           FullWidth
                           Class="mb-4">
                    @foreach (var tag in TagOptions)
                    {
                        <MudSelectItem Value="@tag">@tag</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        </MudItem>

        <!-- Export Summary Section -->
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-6" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Export Summary</MudText>
                <MudDivider Class="mb-4" />

                <MudStack Spacing="2">
                    <MudText Typo="Typo.body1">
                        Estimated Entries: <b>@FilteredCount</b>
                    </MudText>
                    <MudText Typo="Typo.body1">
                        Format: <b>PDF</b>
                    </MudText>
                </MudStack>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Default"
                           Size="Size.Large"
                           Class="mt-6"
                           FullWidth
                           OnClick="ExportToPdf">
                    Export to PDF
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private DateRange DateRange = new(DateTime.Today.AddDays(-30), DateTime.Today);
    private List<string> SelectedMoods = new();
    private List<string> SelectedTags = new();
    private int FilteredCount = 0;

    private readonly List<string> MoodOptions = new() { "Happy", "Joyful", "Calm", "Stressed", "Anxious", "Motivated" };
    private readonly List<string> TagOptions = new() { "#productivity", "#work", "#goals", "#reflection", "#planning", "#challenges" };

    private async Task ApplyFilters()
    {
        if (!Auth.CurrentUserId.HasValue) return;

        var entries = await Entities.GetEntriesByUserAsync(Auth.CurrentUserId.Value);

        entries = entries.Where(e =>
            e.Date >= DateRange.Start && e.Date <= DateRange.End &&
            (!SelectedMoods.Any() || SelectedMoods.Contains(e.PrimaryMood)) &&
            (!SelectedTags.Any() || SelectedTags.All(tag =>
                (e.Tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => t.Trim())
                    .Contains(tag)))
        ).ToList();

        FilteredCount = entries.Count;
        StateHasChanged();
    }

    private async void OnSelectedMoodsChanged(IEnumerable<string> values)
    {
        SelectedMoods = values.ToList();
        await ApplyFilters();
    }

    private async void OnSelectedTagsChanged(IEnumerable<string> values)
    {
        SelectedTags = values.ToList();
        await ApplyFilters();
    }

    private async void OnDateRangeChanged(DateRange range)
    {
        DateRange = range;
        await ApplyFilters();
    }

    private async Task ExportToPdf()
    {
        if (!Auth.CurrentUserId.HasValue) return;

        var entries = await Entities.GetEntriesByUserAsync(Auth.CurrentUserId.Value);

        entries = entries.Where(e =>
            e.Date >= DateRange.Start && e.Date <= DateRange.End &&
            (!SelectedMoods.Any() || SelectedMoods.Contains(e.PrimaryMood)) &&
            (!SelectedTags.Any() || SelectedTags.All(tag =>
                (e.Tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => t.Trim())
                    .Contains(tag)))
        ).ToList();

        FilteredCount = entries.Count;

        var pdfBytes = PdfExportService.GenerateJournalPdf(entries);
        var base64 = Convert.ToBase64String(pdfBytes);

        await JS.InvokeVoidAsync("saveFile", "Dainiki-export.pdf", base64);
    }

    protected override async Task OnInitializedAsync()
    {
        await ApplyFilters();
    }
}