@page "/analytics"
@using MudBlazor
@using Dainiki.Components.Models
@inject AuthService Auth
@inject EntityService Entities

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h4" Class="mb-6">Analytics Dashboard</MudText>

    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Overall Mood</MudText>
                <MudText Typo="Typo.h6">@($"{analytics.MoodData.FirstOrDefault(m => m.Mood == "Positive")?.Value}% Positive")</MudText>
                <MudText Typo="Typo.caption">Most frequent: @analytics.MostFrequentMood</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Avg Word Count</MudText>
                <MudText Typo="Typo.h6">@($"{analytics.AvgWordCount} words")</MudText>
                <MudText Typo="Typo.caption">Per entry average</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Current Streak</MudText>
                <MudText Typo="Typo.h6">@($"{analytics.CurrentStreak} days")</MudText>
                <MudText Typo="Typo.caption">Longest: @($"{analytics.LongestStreak} days")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Top Tag</MudText>
                <MudText Typo="Typo.h6">@analytics.TopTag</MudText>
                <MudText Typo="Typo.caption">Used @analytics.TagData.FirstOrDefault(t => t.Tag == analytics.TopTag)?.Count times</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Mood Distribution</MudText>
                <MudChart ChartType="ChartType.Pie"
                          InputData="@analytics.MoodData.Select(m => m.Value).ToArray()"
                          InputLabels="@analytics.MoodData.Select(m => m.Mood).ToArray()"
                          Width="100%" Height="350px" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Entries Trend</MudText>
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@entryTrendSeries"
                          XAxisLabels="@analytics.EntryData.Select(e => e.Date).ToArray()"
                          Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
    </MudGrid>

        <MudGrid Spacing="3">
            <!-- Full-width Most Used Tags -->
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle2">Most Used Tags</MudText>
                    <MudChart ChartType="ChartType.Bar"
                              ChartSeries="@tagSeries"
                              XAxisLabels="@tagLabels"
                              Width="100%" Height="400px" />
                </MudPaper>
            </MudItem>

            <!-- Side-by-side: Tag Category Breakdown + Streak Tracking -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle2">Tag Category Breakdown</MudText>
                    <MudChart ChartType="ChartType.Bar"
                              ChartSeries="@categorySeries"
                              XAxisLabels="@analytics.CategoryData.Select(c => c.Category).ToArray()"
                              Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h5" Class="mb-2">Streak Tracking</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mb-4">Your journaling consistency over the last 10 days</MudText>

                <MudGrid Spacing="2" Direction="Column">
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-2">
                            <MudText Typo="Typo.subtitle2">Current Streak</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">@($"{analytics.CurrentStreak} days")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-2">
                            <MudText Typo="Typo.subtitle2">Longest Streak</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Secondary">@($"{analytics.LongestStreak} days")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-2">
                            <MudText Typo="Typo.subtitle2">Missed Days</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Error">@analytics.MissedDays</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
</MudContainer>

@code {
    private AnalyticsModel analytics = new();
    private string[] tagLabels = Array.Empty<string>();
    private List<ChartSeries> entryTrendSeries = new();
    private List<ChartSeries> tagSeries = new();
    private List<ChartSeries> categorySeries = new();

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUserId.HasValue)
        {
            analytics = await Entities.GetAnalyticsForUserAsync(Auth.CurrentUserId.Value);

            // Build chart series responsive and more dynamic removing the static datas
            entryTrendSeries = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Words",
                    Data = analytics.EntryData.Select(e => e.Words).ToArray()
                }
            };

            tagSeries = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Tags",
                    Data = analytics.TagData
                        .OrderByDescending(t => t.Count)
                        .Take(10)
                        .Select(t => t.Count)
                        .ToArray()
                }
            };

            tagLabels = analytics.TagData
                .OrderByDescending(t => t.Count)
                .Take(10)
                .Select(t => t.Tag)
                .ToArray();

            categorySeries = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Categories",
                    Data = analytics.CategoryData.Select(c => c.Count).ToArray()
                }
            };
        }
    }
}