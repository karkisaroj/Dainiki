@page "/search"
@using Dainiki.Components.Domain.Models
@using MudBlazor
@inject AuthService Auth
@inject EntityService Entities
@using Dainiki.Components.Shared.Constants

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h4" Class="mb-4">Search & Filter</MudText>

    <MudGrid>
        <!-- FILTER PANEL -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Search</MudText>
                <MudTextField @bind-Value="SearchText" Placeholder="Search entries..." Variant="Variant.Outlined" Class="mb-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Date Range</MudText>
                <MudDateRangePicker @bind-DateRange="DateRange" Variant="Variant.Outlined" Class="mb-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Mood</MudText>
                <MudSelect T="string" @bind-Value="SelectedMood" Label="Select Mood" Variant="Variant.Outlined" Clearable="true" Class="mb-4">
                    @foreach (var mood in MoodOptions)
                    {
                        <MudSelectItem Value="@mood">@mood</MudSelectItem>
                    }
                </MudSelect>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Tags</MudText>
                <MudSelect T="string"
                           Label="Select Tags"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectedValues="SelectedTags"
                           SelectedValuesChanged="OnSelectedTagsChanged"
                           Class="mb-4">
                    @foreach (var tag in AvailableTags)
                    {
                        <MudSelectItem Value="@tag">@tag</MudSelectItem>
                    }
                </MudSelect>

                <MudText Typo="Typo.caption" Class="mt-2">
                    Selected: @string.Join(", ", SelectedTags)
                </MudText>

                <MudButton Variant="Variant.Filled" Color="Color.Default" FullWidth="true" OnClick="ApplyFilters">
                    Apply Filters
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" Class="mt-2" OnClick="ClearFilters">
                    Clear All
                </MudButton>
            </MudPaper>
        </MudItem>

        <!-- RESULTS -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Search Results (@FilteredEntries.Count)</MudText>

                @if (!FilteredEntries.Any())
                {
                    <MudText Typo="Typo.caption">No entries found.</MudText>
                }

                @foreach (var entry in FilteredEntries)
                {
                    <MudPaper Class="pa-3 mb-3" Elevation="1">
                        <MudText Typo="Typo.subtitle1">@entry.Title</MudText>
                        <MudText Typo="Typo.caption">@entry.Date.ToString("ddd, MMM dd, yyyy")</MudText>
                        <MudCardContent Class="mt-2">
                            <div class="entry-content">
                                @((MarkupString)entry.Content)
                            </div>
                        </MudCardContent>
                        <MudText Typo="Typo.caption" Class="mt-1">Mood: @entry.PrimaryMood</MudText>
                        <MudText Typo="Typo.caption">Tags: @entry.Tags</MudText>
                    </MudPaper>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string SearchText = string.Empty;
    private DateRange DateRange = new(DateTime.Today.AddDays(-7), DateTime.Today);
    private string? SelectedMood;

    private List<string> SelectedTags = new();

    private readonly List<string> MoodOptions = EntryOptions.PrimaryMoods;

    private List<string> AvailableTags = new();


    private List<EntriesModel> AllEntries = new();
    private List<EntriesModel> FilteredEntries = new();

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUserId.HasValue)
        {
            AllEntries = await Entities.GetEntriesByUserAsync(Auth.CurrentUserId.Value);
            FilteredEntries = AllEntries;
            AvailableTags = AllEntries
                .SelectMany(e => (e.Tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => t.Trim()))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t)
                .ToList();
        }
    }

    private void ApplyFilters()
    {
        FilteredEntries = AllEntries.Where(e =>
            (string.IsNullOrWhiteSpace(SearchText)
                || e.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || e.Content.Contains(SearchText, StringComparison.OrdinalIgnoreCase))

            && (string.IsNullOrWhiteSpace(SelectedMood)
                || e.PrimaryMood == SelectedMood)

            && (!SelectedTags.Any() || SelectedTags.All(tag =>
                (e.Tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => t.Trim().ToLowerInvariant())
                    .Contains(tag.ToLowerInvariant())))

            && (DateRange.Start == null || DateRange.End == null ||
                (e.Date >= DateRange.Start && e.Date <= DateRange.End))
        ).ToList();
    }

    private void ClearFilters()
    {
        SearchText = string.Empty;
        SelectedMood = null;
        SelectedTags.Clear();
        DateRange = new DateRange(DateTime.Today.AddDays(-7), DateTime.Today);
        FilteredEntries = AllEntries;
    }

    private void OnSelectedTagsChanged(IEnumerable<string> selectedValues)
    {
        SelectedTags = selectedValues.ToList();
    }
}