@page "/search"
@using Dainiki.Components.Domain.Models
@using MudBlazor
@inject AuthService Auth
@inject EntityService Entities
@using Dainiki.Components.Shared.Constants

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudGrid Gutter="GutterSize.Small">
        <!-- FILTER SIDEBAR -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-6" Elevation="3">
                <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Filters</MudText>
                <MudDivider Class="mb-4" />

                <MudTextField @bind-Value="SearchText"
                              Label="Search"
                              Placeholder="Search entries..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Normal"
                              FullWidth
                              Class="mb-4" />

                <MudDateRangePicker @bind-DateRange="DateRange"
                                    Label="Date Range"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Normal"
                                    FullWidth
                                    Class="mb-2" />
                                        
                <MudSelect T="string"
                           @bind-Value="SelectedMood"
                           Label="Mood"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Margin="Margin.None"
                           FullWidth
                           Class="mb-4">
                    @foreach (var mood in MoodOptions)
                    {
                        <MudSelectItem Value="@mood">@mood</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Label="Tags"
                           Variant="Variant.Outlined"
                           MultiSelection="true"
                           SelectedValues="SelectedTags"
                           SelectedValuesChanged="OnSelectedTagsChanged"
                           Margin="Margin.None"
                           FullWidth
                           Class="mb-4">
                    @foreach (var tag in AvailableTags)
                    {
                        <MudSelectItem Value="@tag">@tag</MudSelectItem>
                    }
                </MudSelect>


                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Default"
                               FullWidth
                               OnClick="ApplyFilters">
                        Apply Filters
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth
                               OnClick="ClearFilters">
                        Clear All
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <!-- RESULTS LIST -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-6" Elevation="3">
                <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">
                    Search Results (@FilteredEntries.Count)
                </MudText>
                <MudDivider Class="mb-4" />

                @if (!FilteredEntries.Any())
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">No entries found.</MudText>
                }

                @foreach (var entry in FilteredEntries)
                {
                    <MudCard Class="mb-4" Elevation="2">
                        <MudCardHeader>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@entry.Title</MudText>
                            <MudSpacer/>
                            <MudText Typo="Typo.caption" Class="text-secondary">
                                @entry.Date.ToString("ddd, MMM dd, yyyy")
                            </MudText>
                        </MudCardHeader>

                        <MudCardContent>
                            <div class="entry-content" style="line-height:1.6; font-size:0.95rem;">
                                @((MarkupString)entry.Content)
                            </div>
                        </MudCardContent>

                        <MudDivider />

                        <MudCardActions>
                            <MudText Typo="Typo.caption">Mood: @entry.PrimaryMood</MudText>
                            <MudText Typo="Typo.caption" Class="ml-4">Tags: @entry.Tags</MudText>
                        </MudCardActions>
                    </MudCard>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string SearchText = string.Empty;
    private DateRange DateRange = new(DateTime.Today.AddDays(-7), DateTime.Today);
    private string? SelectedMood;

    private List<string> SelectedTags = new();

    private readonly List<string> MoodOptions = EntryOptions.PrimaryMoods;

    private List<string> AvailableTags = new();


    private List<EntriesModel> AllEntries = new();
    private List<EntriesModel> FilteredEntries = new();

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUserId.HasValue)
        {
            AllEntries = await Entities.GetEntriesByUserAsync(Auth.CurrentUserId.Value);
            FilteredEntries = AllEntries;
            AvailableTags = AllEntries
                .SelectMany(e => (e.Tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => t.Trim()))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t)
                .ToList();
        }
    }

    private void ApplyFilters()
    {
        FilteredEntries = AllEntries.Where(e =>
            (string.IsNullOrWhiteSpace(SearchText)
                || e.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || e.Content.Contains(SearchText, StringComparison.OrdinalIgnoreCase))

            && (string.IsNullOrWhiteSpace(SelectedMood)
                || e.PrimaryMood == SelectedMood)

            && (!SelectedTags.Any() || SelectedTags.All(tag =>
                (e.Tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => t.Trim().ToLowerInvariant())
                    .Contains(tag.ToLowerInvariant())))

            && (DateRange.Start == null || DateRange.End == null ||
                (e.Date >= DateRange.Start && e.Date <= DateRange.End))
        ).ToList();
    }

    private void ClearFilters()
    {
        SearchText = string.Empty;
        SelectedMood = null;
        SelectedTags.Clear();
        DateRange = new DateRange(DateTime.Today.AddDays(-7), DateTime.Today);
        FilteredEntries = AllEntries;
    }

    private void OnSelectedTagsChanged(IEnumerable<string> selectedValues)
    {
        SelectedTags = selectedValues.ToList();
    }
}