@page "/"
@using Dainiki.Components.Application.Services
@inject AuthService Auth
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        if (Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/dashboard");
            StateHasChanged();
        }
      
        else
        {
            Nav.NavigateTo("/login");
        }
    }
}
