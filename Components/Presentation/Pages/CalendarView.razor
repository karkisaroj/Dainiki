@page "/calendar"
@using Dainiki.Components.Application.Services
@using Dainiki.Components.Domain.Models
@using Dainiki.Components.Shared
@using MudBlazor
@inject AuthService Auth
@inject EntityService Entities
@inject IDialogService DialogService
@inject NavigationManager navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudPaper Class="pa-6" Style="max-height:80vh; overflow:auto;" Elevation="3">
        <MudGrid Spacing="4">
            <!-- Calendar Sidebar -->
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Calendar</MudText>
                <MudDatePicker Date="SelectedDate"
                               Color="Color.Default"
                               DateChanged="OnDateChanged"
                               PickerVariant="PickerVariant.Static"
                               DisableTextField
                               HighlightToday />
            </MudItem>

            <!-- Entry Display -->
            <MudItem xs="12" md="8" Class="pl-md-6 mt-6 mt-md-0">
                <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">
                    Entry for @SelectedDate?.ToString("MMMM dd, yyyy")
                </MudText>

                @if (!EntryToday.Any())
                {
                    <MudText Align="Align.Center" Class="py-12 text-secondary">
                        No entry for this day
                    </MudText>
                }
                else
                {
                    var entry = EntryToday.First();
                    <MudPaper Outlined Class="pa-4 mb-4" Style="cursor:pointer" @onclick="() => ShowEntryPopup(entry)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@entry.Title</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="()=>EditEntry(entry)" />
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @(entry.Time.HasValue? DateTime.Today.Add(entry.Time.Value).ToString("hh:mm tt") : "Time not set")
                        </MudText>

                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-2">
                            @entry.PrimaryMood
                        </MudChip>
                    </MudPaper>
                }

                <!-- Navigation Buttons -->
                <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="mt-4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="GoToPreviousDay">
                        Previous Day
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@IsFutureDate"
                               OnClick="GoToNextDay">
                        Next Day
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private DateTime? SelectedDate = DateTime.Today;
    private List<EntriesModel> AllEntries = new();

    private List<EntriesModel> EntryToday =>
        AllEntries
            .Where(e => SelectedDate.HasValue && e.CreatedAt.Date == SelectedDate.Value.Date)
            .OrderBy(e => e.CreatedAt.TimeOfDay)
            .ToList();

    private bool IsFutureDate => SelectedDate.HasValue && SelectedDate.Value.Date >= DateTime.Today.Date;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUserId.HasValue)
        {
            AllEntries = await Entities.GetEntriesByUserAsync(Auth.CurrentUserId.Value);
        }
    }

    private void OnDateChanged(DateTime? newDate)
    {
        SelectedDate = newDate;
    }

    private void GoToNextDay()
    {
        if (SelectedDate.HasValue)
            SelectedDate = SelectedDate.Value.AddDays(1);
    }

    private void GoToPreviousDay()
    {
        if (SelectedDate.HasValue)
            SelectedDate = SelectedDate.Value.AddDays(-1);
    }

    private void EditEntry(EntriesModel entry)
    {
        navigation.NavigateTo($"/addentry/{entry.Id}");
    }

    private async Task ShowEntryPopup(EntriesModel entry)
    {
        var parameters = new DialogParameters { ["Entry"] = entry };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<EntryDetailDialog>("Entry Details", parameters, options);
    }
}