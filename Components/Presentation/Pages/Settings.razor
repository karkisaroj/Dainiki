@page "/settings"
@using Dainiki.Components.Domain.Models
@using MudBlazor
@using Dainiki.Components.Database
@inject JournalDatabase Db
@inject AuthService Auth
@inject ISnackbar snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">

    <!-- User Info -->
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Account Info</MudText>
        <MudText Typo="Typo.body2">Logged in as: <b>@FirstName</b></MudText>
    </MudPaper>

    <!-- Privacy & Security -->
    <MudPaper Class="pa-4 mb-4">
        <MudTextField T="string" Label="Current Password" InputType="InputType.Password" @bind-Value="resetModel.CurrentPassword" />
        <MudTextField T="string" Label="New Password" InputType="InputType.Password" @bind-Value="resetModel.NewPassword" />
        <MudTextField T="string" Label="Confirm New Password" InputType="InputType.Password" @bind-Value="resetModel.ConfirmPassword" />
        <MudButton OnClick="ChangePassword">Change Password</MudButton>

    </MudPaper>

    <!-- Danger Zone -->
    <MudPaper Class="pa-4 mb-4" Style="border: 1px solid red;">
        <MudText Typo="Typo.subtitle1" Color="Color.Error" Class="mb-2">Danger Zone</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">Irreversible actions for your account</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Error">Delete Account Permanently</MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string FirstName { get; set; } = "";
    private User? user;
    private ResetPasswordModel resetModel = new();

    private string CurrentPassword { get; set; } = "";
    private string NewPassword { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (Auth.CurrentUserId.HasValue)
        {
            user = await Db.GetUserByUsernameAsync(Auth.CurrentUser!);
            if (user != null)
            {
                FirstName = user.FirstName;
            }
        }
    }

    private async Task ChangePassword()
    {
        var success = await Auth.UpdateUserPasswordAsync(resetModel);
        snackbar.Add(success ? "Password updated successfully" : "Password update failed",
                     success ? Severity.Success : Severity.Error);
    }

}