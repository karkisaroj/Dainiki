@page "/forgot-password"
@using Dainiki.Components.Domain.Models
@using MudBlazor
@inject AuthService Auth
@inject ISnackbar snackbar
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center min-vh-100">
    <MudPaper Class="pa-6" Elevation="3" Style="width:100%; max-width:480px;">
        <MudText Typo="Typo.h4" Class="mb-2 font-weight-bold text-center">Reset Your Password</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 text-center">
            Enter your username and new password to reset your account.
        </MudText>

        <MudForm @ref="form">
            <MudTextField T="string"
                          Label="Username"
                          @bind-Value="resetModel.Username"
                          Required="true"
                          RequiredError="Username is required"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudTextField T="string"
                          Label="New Password"
                          @bind-Value="resetModel.NewPassword"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="New password is required"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudTextField T="string"
                          Label="Confirm New Password"
                          @bind-Value="resetModel.ConfirmPassword"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Confirm password is required"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="ResetPassword"
                           Style="text-transform: uppercase; font-weight: 600; padding: 10px 24px;">
                    Reset Password
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="GoToLogin"
                           Style="text-transform: uppercase; font-weight: 600; padding: 10px 24px;">
                    Back to Login
                </MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private ResetPasswordModel resetModel = new();
    private MudForm? form;

    private async Task ResetPassword()
    {
        if (form is null)
            return;

        await form.Validate();

        if (!form.IsValid)
        {
            snackbar.Add("Please fix the errors before submitting.", Severity.Error);
            return;
        }

        if (resetModel.NewPassword != resetModel.ConfirmPassword)
        {
            snackbar.Add("New password and confirmation do not match.", Severity.Error);
            return;
        }

        var success = await Auth.UpdateUserPasswordAsync(resetModel, isForgotFlow: true);

        snackbar.Add(success
            ? "Password reset successfully. Please login with your new password."
            : "Password reset failed. Check your username.",
            success ? Severity.Success : Severity.Error);

        if (success)
        {
            await Task.Delay(1500);
            Nav.NavigateTo("/login");
        }
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}