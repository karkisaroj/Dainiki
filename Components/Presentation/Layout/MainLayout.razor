@inherits LayoutComponentBase
@using Dainiki.Components.Application.Services
@using Dainiki.Components.Domain.Models
@using MudBlazor
@using Dainiki.Components.Shared.Theme
@using Dainiki.Components.Database
@inject AuthService Auth
@inject JournalDatabase Db
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    @if (Auth.IsLoggedIn)
    {
        <MudAppBar Elevation="1" Dense Class="px-4"
                   Style="border-bottom:1px solid var(--mud-palette-divider);">

            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Edge="Edge.Start"
                           Color="Color.Inherit"
                           OnClick="ToggleDrawer" />

            <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">
                Dainiki
            </MudText>

            <MudSpacer />

            <MudSwitch T="bool"
                       Value="_isDarkMode"
                       ValueChanged="OnDarkModeChanged"
                       Color="Color.Primary"
                       ThumbIcon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen"
                   Variant="DrawerVariant.Responsive"
                   Elevation="0"
                   Class="pa-3"
                   Style="border-right:1px solid var(--mud-palette-divider);">
            <NavMenu />
        </MudDrawer>
    }
    else
    {
        <MudAppBar Elevation="1" Dense Class="px-4">
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                Dainiki
            </MudText>

            <MudSpacer />

            <MudSwitch T="bool"
                       @bind-Value="_isDarkMode"
                       Color="Color.Primary"
                       ThumbIcon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" />
        </MudAppBar>
    }

    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>

</MudLayout>

@code {
    private readonly MudTheme _theme = new AppTheme();
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += StateHasChanged;

        // Load dark mode from Auth or DB
        _isDarkMode = Auth.IsDarkMode;

        if (Auth.IsLoggedIn && Auth.CurrentUserId.HasValue)
        {
            var user = await Db.GetUserByUsernameAsync(Auth.CurrentUser!);
            if (user != null)
            {
                _isDarkMode = user.IsDarkMode;
                Auth.IsDarkMode = user.IsDarkMode;
            }
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
        Auth.IsDarkMode = _isDarkMode;
    }

    private async Task OnDarkModeChanged(bool value)
    {
        _isDarkMode = value;
        Auth.IsDarkMode = value;

        if (Auth.IsLoggedIn && Auth.CurrentUserId.HasValue)
        {
            await Db.UpdateUserThemePreferenceAsync(Auth.CurrentUserId.Value, value);
        }

        await Auth.UpdateThemePreferenceAsync(value);
    }
}